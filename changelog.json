            },
            {
              "id": "ef28321",
              "scope": "android,config",
              "text": "Отключён по умолчанию системный HTTP-прокси VpnService (с авто-миграцией при обновлении с v1.0.4), включено сохранение кэша FakeIP (store-fake-ip) и очищен список системных исключений"
            }
